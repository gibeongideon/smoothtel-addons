<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_kpi_thresholds" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.kpi.thresholds</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="KPI Tracker" name="traffic_light_kpi" groups="traffic_light_kpi.group_kpi_admin">
                    <block title="KPI Rating Thresholds">
                        <setting string="5 – Outstanding (Blue)" help="Minimum achievement % of target. Study and replicate this success elsewhere.">
                            <field name="kpi_outstanding_threshold"/>
                        </setting>
                        <setting string="4 – Exceeds Expectations (Green)" help="Minimum achievement % of target. Recognize and reward the team.">
                            <field name="kpi_exceeds_threshold"/>
                        </setting>
                        <setting string="3 – Meets Expectations (Green)" help="Minimum achievement % of target. Maintain current operations.">
                            <field name="kpi_green_threshold"/>
                        </setting>
                        <setting string="2 – Needs Improvement (Yellow)" help="Minimum achievement % of target. Minor adjustments and coaching required. Lower values are rated 1 – Unacceptable (Red).">
                            <field name="kpi_yellow_threshold"/>
                        </setting>
                        <div class="text-muted mt-2">
                            Example: 120 / 100 / 80 / 50 means 120%+ is Outstanding, 100–119% Exceeds, 80–99% Meets,
                            50–79% Needs Improvement and below 50% Unacceptable. Compliance KPIs use compliance % divided by their target.
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_kpi_settings" model="ir.actions.act_window">
        <field name="name">KPI Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'traffic_light_kpi', 'bin_size': False}</field>
    </record>

</odoo>
