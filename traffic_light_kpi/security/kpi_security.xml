<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Security Groups -->
    <record id="group_kpi_user" model="res.groups">
        <field name="name">KPI: User</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- Auto-assign KPI user access to every internal user -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('traffic_light_kpi.group_kpi_user'))]"/>
    </record>

    <record id="group_kpi_manager" model="res.groups">
        <field name="name">KPI: Manager</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('group_kpi_user'))]"/>
    </record>

    <record id="group_kpi_admin" model="res.groups">
        <field name="name">KPI: Administrator</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('group_kpi_manager'))]"/>
    </record>

    <!-- Record Rules -->

    <!-- kpi.result: employees see only their own records -->
    <record id="rule_kpi_result_own" model="ir.rule">
        <field name="name">KPI Result: Own Records Only</field>
        <field name="model_id" ref="model_kpi_result"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_kpi_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- kpi.result: managers see all records -->
    <record id="rule_kpi_result_manager" model="ir.rule">
        <field name="name">KPI Result: Manager Full Read</field>
        <field name="model_id" ref="model_kpi_result"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_kpi_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- kpi.traffic.light: employees see only their own -->
    <record id="rule_kpi_traffic_light_own" model="ir.rule">
        <field name="name">KPI Traffic Light: Own Record Only</field>
        <field name="model_id" ref="model_kpi_traffic_light"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_kpi_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- kpi.traffic.light: managers see all -->
    <record id="rule_kpi_traffic_light_manager" model="ir.rule">
        <field name="name">KPI Traffic Light: Manager Full Read</field>
        <field name="model_id" ref="model_kpi_traffic_light"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_kpi_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
