<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="file_system_sequence" model="ir.sequence">
            <field name="name">Register File Sequence</field>
            <field name="code">register.file</field>
            <field name="prefix">RTC/</field>
            <field name="suffix">/%(y)s</field>
            <field name="padding">4</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False" />
        </record>


        <record id="shipping_system_sequence" model="ir.sequence">
            <field name="name">Shipping File Sequence</field>
            <field name="code">shipping.file</field>
            <field name="prefix">RTCSH/</field>
            <field name="suffix">/%(y)s</field>
            <field name="padding">4</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False" />
        </record>

        <record id="finance_system_sequence" model="ir.sequence">
            <field name="name">Finance Charges Sequence</field>
            <field name="code">finance.charges</field>
            <field name="prefix">RTCF/</field>
            <field name="suffix">/%(y)s</field>
            <field name="padding">4</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False" />
        </record>

    </data>
</odoo>