<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="res_company_view_form" model="ir.ui.view">
            <field name="name">res.company.view.form</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <div name="button_box" position="inside">
                        <button class="oe_stat_button" type="object"
                                name="company_document_details_action"
                                icon="fa-book">
                            <field string="Documents" name="documents_count" widget="statinfo"/>
                        </button>
                    </div>
                </xpath>
                <xpath expr="//page[@name='branches']" position="after">
                    <page string="Document History" name="document_history">
                        <field name="company_document_ids" mode="kanban">
                            <kanban>
                                <field name="name"/>
                                <field name="issue_date"/>
                                <field name="expiry_date"/>
                                <field name="document"/>
                                <templates>
                                    <t t-name="card">
                                        <div class="oe_kanban_global_click">
                                            <div class="oe_kanban_details">
                                                <div class="row">
                                                    <div class="col-12 mb-0">
                                                        <strong class="o_kanban_record_title oe_partner_heading mb-0">
                                                            <h2 class="mb-0 d-inline">
                                                                <field name="name"/>
                                                            </h2>
                                                        </strong>
                                                    </div>
                                                    <div class="col-12">
                                                        <hr/>
                                                        <div>
                                                            <ul>
                                                                <li>
                                                                    <i class="fa fa-clock-o"
                                                                       style="padding-left:5px;"
                                                                       aria-hidden="true"/>
                                                                    <span style="padding-left:5px;">Validity:</span>
                                                                    <span style="padding-left:5px;">
                                                                        <field name="issue_date"/>
                                                                    </span>
                                                                    <i class="fa fa-arrow-right"
                                                                       style="padding-left:5px;"
                                                                       aria-hidden="true"/>
                                                                    <span style="padding-left:5px;">
                                                                        <field name="expiry_date"/>
                                                                    </span>
                                                                </li>
                                                                <li>
                                                                    <i class="fa fa-file-text"
                                                                       style="padding-left:5px;"
                                                                       aria-hidden="true"/>
                                                                    <span style="padding-left:5px;">Type:</span>
                                                                    <span style="padding-left:5px;">
                                                                        <field name="document_type_id"
                                                                        />
                                                                    </span>
                                                                </li>
                                                                <li>
                                                                    <i class="fa fa-book"
                                                                       style="padding-left:5px;"
                                                                       aria-hidden="true"/>
                                                                    <span style="padding-left:5px;">Document:</span>
                                                                    <span style="padding-left:5px;">
                                                                        <field name="document"
                                                                               filename="document_name"
                                                                               widget="binary"/>
                                                                        <field name="document_name" invisible="1"/>
                                                                    </span>
                                                                </li>
                                                            </ul>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>