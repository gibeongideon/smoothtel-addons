<odoo>
    <!-- Email template for send notification for document expiry -->
    <record id="email_template_expiry_reminder" model="mail.template">
        <field name="name">Document Expiry Reminder</field>
        <field name="model_id" ref="tk_company_documents.model_company_document_details"/>
        <field name="email_from">{{ (object.company_id.email) }}</field>
        <field name="partner_to">{{ object.responsible_user_id.partner_id.id }}</field>
        <field name="subject">Reminder: Document "{{ object.name }}" Expiring on {{ object.expiry_date }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Dear,<t t-out="object.responsible_user_id.name or ''"/>
                </p>
                <p>This is a reminder that the document
                    <strong>
                        <t t-out="object.name or ''"/>
                    </strong>
                    is set to expire on
                    <strong>
                        <t t-out="object.expiry_date or ''"/>
                    </strong>
                    .
                </p>
                <p>Please take necessary action before this date.</p>
                <p>Thank you.</p>
            </div>
        </field>
    </record>
</odoo>
